# =============================================================================
# ARYVON Material Handling Solutions - Backend Environment Configuration
# ZERO DATABASE: No database connection or SQL configuration is needed.
# =============================================================================

# Server Port (cPanel Phusion Passenger provides this automatically, 5000 for local dev)
PORT=5000
NODE_ENV=development

# Resend API Key (Generate at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Outgoing From Email Address:
# - For testing/free accounts without custom domain verified:
#   FROM_EMAIL="ARYVON Material Handling <onboarding@resend.dev>"
# - Once your domain (e.g. aryvon.in or yourdomain.com) is verified in Resend:
#   FROM_EMAIL="ARYVON Material Handling <contact@yourdomain.com>"
FROM_EMAIL="ARYVON Material Handling <onboarding@resend.dev>"

# Destination Email Address for Owner/Admin Inquiries
OWNER_EMAIL=aryvonmhe@gmail.com

# Company Support Contact (used in customer confirmation email and on-screen message)
SUPPORT_PHONE="80802 38541"

# Allowed Frontend URL for CORS (or * for any)
CLIENT_URL=http://localhost:5173

