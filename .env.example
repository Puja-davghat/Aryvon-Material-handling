# Owner / Admin Email (receives all enquiry notifications with full lead details)
OWNER_EMAIL=aryvonmhe@gmail.com

# Support Contact
SUPPORT_PHONE="80802 38541"

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
