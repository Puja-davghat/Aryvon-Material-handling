# =============================================================================
# ARYVON Material Handling Solutions - Environment Variables
# ZERO DATABASE: No database connection or SQL configuration is needed.
# =============================================================================

PORT=5000
NODE_ENV=development

# Resend API Key (Generate at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Outgoing From Email Address (use onboarding@resend.dev until your custom domain is verified in Resend)
