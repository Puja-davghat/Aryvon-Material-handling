
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value date.timezone "Asia/Kolkata"
   php_value error_log "/home/aryvonma/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value date.timezone "Asia/Kolkata"
   php_value error_log "/home/aryvonma/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# BEGIN Website Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # strip trailing slash (except root)
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ https://%{HTTP_HOST}%1 [L,R=301]

    # prerendered route entry files (bots + browsers get real head/JSON-LD/noscript)
    RewriteRule ^products/?$ prerender/products.html [L]
    RewriteRule ^products/vrc/?$ prerender/products-vrc.html [L]
    RewriteRule ^products/scissor-lift/?$ prerender/products-scissor-lift.html [L]
    RewriteRule ^products/eot-crane/?$ prerender/products-eot-crane.html [L]
    RewriteRule ^products/conveyor/?$ prerender/products-conveyor.html [L]
    RewriteRule ^industries/?$ prerender/industries.html [L]
    RewriteRule ^about/?$ prerender/about.html [L]
    RewriteRule ^contact/?$ prerender/contact.html [L]

</IfModule>
# unknown paths -> real 404 (all valid routes are prerendered above); SPA shell as body
ErrorDocument 404 /index.html
# END Website Routing

# BEGIN Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/javascript application/json image/svg+xml
</IfModule>
# END Compression

# BEGIN Cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/jpeg "access plus 1 day"
    ExpiresByType image/webp "access plus 1 day"
    ExpiresByType image/svg+xml "access plus 1 day"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "^index-[A-Za-z0-9_]+\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
# END Cache

